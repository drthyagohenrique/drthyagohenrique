{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mindup.drthyagohenrique.com" }],
      "destination": "https://drthyagohenrique.com/mindup",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "neurocalma.drthyagohenrique.com" }],
      "destination": "https://drthyagohenrique.com/neurocalma",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "links.drthyagohenrique.com" }],
      "destination": "https://drthyagohenrique.com/links",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/links",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mindup",
      "destination": "/mindup.html"
    },
    {
      "source": "/mindup/",
      "destination": "/mindup.html"
    },
    {
      "source": "/((?!api/|assets/|mindup.html|favicon.svg|favicon-32.png|apple-touch-icon.png).*)",
      "destination": "/index.html"
    }
  ]
}
